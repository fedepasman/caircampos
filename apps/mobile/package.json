{
  "name": "@cair/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "App móvil de CAIR para iOS y Android",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cair/schemas": "workspace:*",
    "@cair/shared": "workspace:*",
    "@cair/supabase": "workspace:*",
    "@cair/tokens": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "expo": "57.0.8",
    "expo-constants": "57.0.7",
    "expo-linking": "57.0.4",
    "expo-router": "57.0.8",
    "expo-secure-store": "57.0.1",
    "expo-status-bar": "57.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@cair/config": "workspace:*",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
