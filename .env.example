# ═══════════════════════════════════════════════════════════════════════════
# CAIR — Plantilla de variables de entorno
#
# Copiar a `.env.local` y completar. NUNCA completar valores en este archivo
# ni versionar un `.env` real: `.gitignore` los bloquea a propósito.
#
# Regla de exposición:
#   NEXT_PUBLIC_*  → viaja al navegador. Solo claves publicables.
#   EXPO_PUBLIC_*  → queda embebida en el binario de la app. Solo publicables.
#   Sin prefijo    → solo servidor. Jamás importar desde un componente cliente.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Supabase ──────────────────────────────────────────────────────────────
# Región del proyecto: AWS South America (São Paulo, sa-east-1). No es
# modificable una vez creado el proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOLO SERVIDOR. Evade RLS por completo: filtrar esta clave equivale a exponer
# la base entera. Uso restringido a Edge Functions; nunca en apps/*.
SUPABASE_SECRET_KEY=

# Cadena de conexión directa. Solo para migraciones y tareas administrativas.
# Desde entornos serverless usar siempre el pooler (puerto 6543).
SUPABASE_DB_URL=

# ─── Cloudflare R2 ─────────────────────────────────────────────────────────
# Credenciales SOLO SERVIDOR. Las subidas del cliente se hacen exclusivamente
# con URLs firmadas emitidas por una Edge Function.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Dominio propio servido por Cloudflare, para lectura pública y transformación
# de imágenes sin pagar optimización en Vercel.
NEXT_PUBLIC_R2_PUBLIC_URL=

# ─── Mapbox ────────────────────────────────────────────────────────────────
# Token público: restringirlo por dominio/bundle-id en el panel de Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_MAPBOX_TOKEN=
# Token secreto con scope DOWNLOADS:READ, necesario para compilar el SDK nativo
# en iOS. Va en EAS Secrets, nunca en un archivo del repositorio.
MAPBOX_DOWNLOAD_TOKEN=

# ─── Resend (email transaccional) ──────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Sentry (observabilidad) ───────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Token de subida de source maps. Solo CI.
SENTRY_AUTH_TOKEN=

# ─── URLs de la aplicación ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
