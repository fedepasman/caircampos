{
  "name": "cair",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de búsqueda y comercialización de campos — Cámara Argentina de Inmobiliarias Rurales",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "security": "node scripts/verificar-reglas-semgrep.mjs && semgrep --config p/security-audit --config p/typescript --config .semgrep/cair.yaml --exclude .semgrep/fixtures --error --skip-unknown-extensions .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:sync": "supabase db diff -f",
    "db:test": "supabase test db",
    "db:advisors": "supabase db advisors",
    "db:types": "node scripts/gen-types.mjs",
    "db:types:check": "pnpm db:types && git diff --exit-code packages/supabase/src/database.types.ts",
    "db:lote-demo": "node scripts/generar-lote-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "2.10.6",
    "typescript": "catalog:"
  }
}
